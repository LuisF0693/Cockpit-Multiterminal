{
  "name": "@cockpit/pty-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "smoke:codex": "vitest run --config vitest.smoke.config.ts src/codex-delivery.smoke.ts"
  },
  "dependencies": {
    "@cockpit/adapter-antigravity": "workspace:*",
    "@cockpit/adapter-claude-code": "workspace:*",
    "@cockpit/adapter-codex": "workspace:*",
    "@cockpit/adapter-contract": "workspace:*",
    "@cockpit/adapter-gemini-cli": "workspace:*",
    "@cockpit/adapter-grok": "workspace:*",
    "@cockpit/adapter-ollama": "workspace:*",
    "@cockpit/adapter-shell": "workspace:*",
    "@cockpit/shared": "workspace:*",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
